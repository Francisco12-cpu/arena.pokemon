{
  "name": "Arena Pokémon",
  "short_name": "Arena Pokémon",
  "description": "Batalhas Pokémon em tempo real. Projeto de fã sem fins lucrativos, feito como presente de aniversário. Criado por Francisco Audir (@filho.af).",
  "lang": "pt-BR",
